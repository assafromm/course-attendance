PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DEV_LOGIN=true
DATABASE_PATH=data/attendance.sqlite
FRONTEND_URL=http://localhost:4173
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Supabase Google OAuth, as used by Journal Compass. Configure the
# exact FRONTEND_URL + '/' as an allowed Auth redirect. Use only a publishable
# key, never a service-role/secret key. Authorizations stay in this app's database.
# Production: NODE_ENV=production, DEV_LOGIN=false, HOST=0.0.0.0.
# Set FRONTEND_URL to the website URL and ADMIN_EMAILS to authorized admins.
# Any verified Google email is eligible, but still needs an explicit permission.
