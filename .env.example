PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DEV_LOGIN=true
DATABASE_PATH=data/attendance.sqlite
FRONTEND_URL=http://localhost:4173
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAINS=
ADMIN_EMAILS=
